# NSFW Mask（加固版）环境变量示例
#
# 复制为 .env 或直接 export 到环境里即可。全部可省略 —— 省略时使用
# 下面注释里标注的默认值，且默认值一律偏向"安全"一侧。

# ---------- 监听 ----------
# 默认 127.0.0.1（仅本机可访问）。要对外提供服务必须显式改成 0.0.0.0，
# 并且强烈建议在前面套一层反向代理做 TLS 与访问控制。
# NSFW_HOST=127.0.0.1
# NSFW_PORT=8000

# ---------- 鉴权 ----------
# 不设置时，首次启动会自动生成随机密钥并写入 data/api_key（权限 0600）。
# 若设置，长度不得少于 16 个字符。
# NSFW_API_KEY=请替换为你自己的长随机串

# 下载令牌有效期（秒），默认 3600。
# NSFW_TOKEN_TTL=3600

# ---------- 反向代理 ----------
# 只有来自这些地址的 X-Forwarded-For 才会被采信（默认仅本机回环）。
# 同机部署 Nginx 时填 127.0.0.1 即可。
# NSFW_TRUSTED_PROXIES=127.0.0.1,::1

# 设为 1 则信任任意代理。仅在你完全清楚后果时使用：
# 开启后任何人都能伪造源 IP，限流将形同虚设。
# NSFW_TRUST_ALL_PROXIES=0

# ---------- CORS ----------
# 默认不放行任何跨域来源（前端与后端同源）。确需跨域时用逗号分隔列出。
# NSFW_CORS_ORIGINS=https://example.com

# ---------- 上传与并发 ----------
# NSFW_MAX_FILE_SIZE=10485760
# NSFW_MAX_BATCH_FILES=20
# NSFW_MAX_CONCURRENCY=2
# NSFW_MAX_IMAGE_PIXELS=16777216

# ---------- 数据保留 ----------
# 结果图保留时长（秒），默认 3600；由后台定时任务执行清理。
# NSFW_RETENTION_SECONDS=3600
# NSFW_CLEANUP_INTERVAL_SECONDS=600

# 数据目录，默认 <项目根>/data
# NSFW_DATA_DIR=
# 打码结果的存放目录，默认 <项目根>/output。
# 这个目录不会被自动清理，结果会一直留着。
# NSFW_OUTPUT_DIR=

# ---------- 模型 ----------
# 3x3 瓦片 Deep Scan 开关，默认开启。关闭可明显提速。
# NSFW_DEEP_SCAN=1

# 分类器模型，默认 Falconsai/nsfw_image_detection
# NSFW_CLASSIFIER_MODEL=Falconsai/nsfw_image_detection

# 国内网络直连 huggingface.co 常常失败，取消下面这行的注释走镜像站。
# 注意：必须使用 pip 安装的 huggingface_hub 支持该变量。
# HF_ENDPOINT=https://hf-mirror.com

# 检测器模型路径。留空则使用 nudenet 内置的 320n 模型（无需下载）。
# NSFW_DETECTOR_MODEL=
